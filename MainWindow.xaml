<Window x:Class="SortVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуализатор сортировки данных"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Стиль кнопки -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3A7AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F63D8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#244EB0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D3A"/>
            <Setter Property="BorderBrush" Value="#3A7AFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                  Grid.ColumnSpan="2"
                                  Focusable="False"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                            <Grid>
                                                <ContentPresenter x:Name="contentPresenter"
                                                          HorizontalAlignment="Left"
                                                          VerticalAlignment="Center"
                                                          Margin="8,0,24,0"
                                                          Content="{TemplateBinding Content}"
                                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                <TextBlock x:Name="selectedText"
                                                   Text="{Binding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,24,0"
                                                   Visibility="Collapsed"/>
                                                <Path x:Name="arrow"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="White"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#5A8CFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                Background="#2D2D3A"
                                BorderBrush="#3A7AFE"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                KeyboardNavigation.DirectionalNavigation="Contained"
                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для выбранного элемента в ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D3A"/>
            <Setter Property="BorderBrush" Value="#3A7AFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <!-- Стиль элементов выпадающего списка -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2D2D3A"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3A7AFE"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A7AFE"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль Slider -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#3A7AFE"/>
            <Setter Property="Background" Value="#333"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#252525" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Данные -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Данные:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="DataSetComboBox" Style="{StaticResource ModernComboBox}" Width="200" Foreground="Black" RenderTransformOrigin="0.5,0.51"/>
                    <Button x:Name="LoadDataButton" Content="Загрузить набор" Style="{StaticResource ModernButton}" Margin="10,0,0,0" Click="LoadDataButton_Click"/>
                    <Button x:Name="DeleteDataSetButton" Content="Удалить набор" Style="{StaticResource ModernButton}" Margin="10,0,0,0" Click="DeleteDataSetButton_Click"/>
                    <Button x:Name="ManualInputButton" Content="Ввести вручную" Style="{StaticResource ModernButton}" Background="#5A5A5A" Margin="10,0,0,0" Click="ManualInputButton_Click"/>

                </StackPanel>

                <!-- Режимы -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="124,0,77,0" Grid.ColumnSpan="2">
                    <TextBlock Text="Режим:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <RadioButton x:Name="SingleModeRadio" Content="Одиночная" 
                 Foreground="White" VerticalAlignment="Center" 
                 IsChecked="True" GroupName="ModeGroup"
                 Checked="ModeRadio_Checked"/>
                    <RadioButton x:Name="TournamentModeRadio" Content="Турнир" 
                 Foreground="White" VerticalAlignment="Center" 
                 Margin="15,0,0,0" GroupName="ModeGroup"
                 Checked="ModeRadio_Checked"/>
                </StackPanel>

                <!-- Статус -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="Статус:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Готов" Foreground="#2ECC71" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ЧАСТЬ: Визуализация -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления (одиночный режим) -->
                    <Border x:Name="SingleModePanel" Grid.Row="0" Background="#252525" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="SortTypeComboBox"
                          Style="{StaticResource ModernComboBox}"
                          Margin="141,0,25,0"
                          Foreground="White"
                          Background="#2D2D3A">
                                <ComboBoxItem Content="Bubble Sort (Пузырьковая)" Foreground="White" Background="#2D2D3A"/>
                                <ComboBoxItem Content="Quick Sort (Быстрая)" Foreground="White" Background="#2D2D3A"/>
                                <ComboBoxItem Content="Insertion Sort (Вставками)" Foreground="White" Background="#2D2D3A"/>
                                <ComboBoxItem Content="Selection Sort (Выбором)" Foreground="White" Background="#2D2D3A"/>
                                <ComboBoxItem Content="Merge Sort (Слиянием)" Foreground="White" Background="#2D2D3A"/>
                            </ComboBox>

                            <Button x:Name="StartSortButton"
                        Grid.Column="1"
                        Content="Старт"
                        Style="{StaticResource ModernButton}"
                        Background="#2ECC71"
                        Click="StartSortButton_Click"/>

                            <Button x:Name="PauseButton"
                        Grid.Column="2"
                        Content="Пауза"
                        Style="{StaticResource ModernButton}"
                        Background="#F39C12"
                        Margin="5,0,0,0"
                        Click="PauseButton_Click"
                        IsEnabled="False"/>

                            <Button x:Name="ResumeButton"
                        Grid.Column="3"
                        Content="Продолжить"
                        Style="{StaticResource ModernButton}"
                        Background="#3498DB"
                        Margin="5,0,0,0"
                        Click="ResumeButton_Click"
                        IsEnabled="False"/>

                            <Button x:Name="StopButton"
                        Grid.Column="4"
                        Content="Стоп"
                        Style="{StaticResource ModernButton}"
                        Background="#D9534F"
                        Margin="5,0,0,0"
                        Click="StopButton_Click"
                        IsEnabled="False"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="15,0,0,0">
                                <TextBlock Text="Задержка:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Slider x:Name="DelaySlider" Width="100" Minimum="0" Maximum="200" Value="30" 
            Style="{StaticResource ModernSlider}"/>
                                <TextBlock x:Name="DelayValueText" Text="30" Foreground="#3A7AFE" FontWeight="Bold" Margin="8,0,0,0"/>

                                <!-- Кнопка с подсказкой -->
                                <Button Content="ⓘ" 
        Width="22" 
        Height="22" 
        FontSize="12" 
        FontWeight="Bold"
        Background="Transparent" 
        Foreground="#3A7AFE" 
        BorderBrush="#3A7AFE" 
        BorderThickness="1"
        Cursor="Hand" 
        Margin="10,0,0,0"
        ToolTipService.ShowOnDisabled="True"
        ToolTipService.InitialShowDelay="0"
        ToolTipService.BetweenShowDelay="0">
                                    <Button.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="300">
                                                <TextBlock Text="Настройка скорости анимации" FontWeight="Bold"/>
                                                <Separator Margin="0,5"/>
                                                <TextBlock Text="Задержка между шагами сортировки." Foreground="#2D2D3A" TextWrapping="Wrap"/>
                                                <TextBlock Text=" " />
                                                <TextBlock Text="По умолчанию: 30 мс (0.03 секунды)" Foreground="#2D2D3A"/>
                                                <TextBlock Text=" " />
                                                <TextBlock Text="Рекомендации:" FontWeight="Bold" Foreground="#2D2D3A"/>
                                                <TextBlock Text="• 0-30 мс   → Быстрая анимация" Foreground="#2D2D3A"/>
                                                <TextBlock Text="• 30-100 мс → Средняя скорость" Foreground="#2D2D3A"/>
                                                <TextBlock Text="• 100-200 мс → Детальный просмотр" Foreground="#2D2D3A"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Canvas для одиночной сортировки -->
                    <Canvas x:Name="VisualizationCanvas"
                Grid.Row="1"
                Background="#111"
                ClipToBounds="True"/>

                    <!-- Контейнер для турнира -->
                    <ContentControl x:Name="TournamentContainer" 
                        Grid.Row="1" 
                        Grid.RowSpan="2"
                        Visibility="Collapsed"/>

                    <!-- Статистика (одиночный режим) -->
                    <Border Grid.Row="2" Background="#252525" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Сравнений:" Foreground="#A0A0B0" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ComparisonsText" Text="0" Foreground="#3A7AFE" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Обменов:" Foreground="#A0A0B0" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SwapsText" Text="0" Foreground="#3A7AFE" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Элементов:" Foreground="#A0A0B0" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ArraySizeText" Text="0" Foreground="#3A7AFE" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Кнопка с подсказкой -->
                            <Button Grid.Column="3" 
                Content="ⓘ" 
                Width="26" 
                Height="26" 
                FontSize="14" 
                FontWeight="Bold"
                Background="Transparent" 
                Foreground="#3A7AFE" 
                BorderBrush="#3A7AFE" 
                BorderThickness="1"
                Cursor="Hand" 
                Margin="10,0,0,0"
                ToolTipService.ShowOnDisabled="True"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.BetweenShowDelay="0">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="320">
                                            <TextBlock Text="Статистика сортировки" FontWeight="Bold" Foreground="#252525"/>
                                            <Separator Margin="0,5"/>
                                            <TextBlock Text="Сравнения — количество операций сравнения элементов." TextWrapping="Wrap" Foreground="#252525"/>
                                            <TextBlock Text=" " />
                                            <TextBlock Text="Обмены — количество перестановок элементов." TextWrapping="Wrap" Foreground="#252525"/>
                                            <TextBlock Text=" " />
                                            <TextBlock Text="Элементов — размер текущего массива." TextWrapping="Wrap" Foreground="#252525"/>
                                            <TextBlock Text=" " />
                                            <TextBlock Text="Эти метрики помогают оценить эффективность алгоритма." TextWrapping="Wrap" FontWeight="Bold" Foreground="#252525"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <!-- ПРАВАЯ ЧАСТЬ: Лог и легенда -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="12" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="История событий"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#3A7AFE"
                               Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" MaxHeight="250">
                        <ListBox x:Name="LogListBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#CCCCCC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252525" CornerRadius="4" Padding="7" Margin="0,2">
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>


                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ClearLogButton" 
            Content="Очистить" 
            Style="{StaticResource ModernButton}"

            Width="80"
            Click="ClearLogButton_Click"/>

                        <Button x:Name="ReportsButton" 
            Content="Отчеты" 
            Style="{StaticResource ModernButton}"

            Width="80"
            Margin="10,0,0,0"
            Click="ReportsButton_Click"/>
                    </StackPanel>

                    <!-- Легенда и информация -->
                    <Border Grid.Row="3" Background="#252525" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Легенда" FontSize="13" FontWeight="Bold" Foreground="#3A7AFE" Margin="0,0,0,8"/>

                            <TextBlock Text="█ Низкое значение" Foreground="#00FF00" FontSize="11" Margin="0,2"/>
                            <TextBlock Text="█ Среднее значение" Foreground="#FFD700" FontSize="11" Margin="0,2"/>
                            <TextBlock Text="█ Высокое значение" Foreground="#FF0000" FontSize="11" Margin="0,2"/>
                            <TextBlock Text="█ Сравниваемый элемент" Foreground="#0088FF" FontSize="11" Margin="0,2"/>
                            <TextBlock Text="█ Меняемый элемент" Foreground="#FF6600" FontSize="11" Margin="0,2"/>
                            <Separator Background="#3A3A3A" Margin="0,10,0,8"/>

                            <TextBlock Text="Информация об алгоритме" FontSize="11" FontWeight="Bold" Foreground="#3A7AFE" Margin="0,0,0,5"/>
                            <TextBlock x:Name="AlgorithmInfo" Text="Выберите алгоритм сортировки" Foreground="#A0A0B0" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>



        <!-- Нижняя панель -->
        <Border Grid.Row="2" Background="#252525" Padding="8">
            <TextBlock x:Name="InfoText"
                       Text="Выберите набор данных и запустите сортировку"
                       Foreground="#A0A0B0"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window>