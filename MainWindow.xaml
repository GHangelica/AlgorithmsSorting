<Window x:Class="SortVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Визуализатор сортировки данных"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>

        <!-- кнопка -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#3A7AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F63D8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#244EB0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ModernComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="#3A7AFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Height" Value="32"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter x:Name="contentPresenter"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Margin="8,0,24,0"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                <Path x:Name="arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#E0E0E0"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#5A8CFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#2D2D2D"
                                        BorderBrush="#3A7AFE"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer>
                                        <ItemsPresenter x:Name="ItemsPresenter"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Height" Value="30"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A7AFE"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A7AFE"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slider -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="#3A7AFE"/>
            <Setter Property="Background" Value="#333"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#252525" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Сортировка данных"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#3A7AFE"
                               Margin="0,0,20,0"/>

                    <!-- ComboBox с данными -->
                    <ComboBox x:Name="DataSetComboBox"
                              Style="{StaticResource ModernComboBox}"
                              Width="200"
                              Margin="10,0"
                              SelectionChanged="DataSetComboBox_SelectionChanged">
                        <ComboBoxItem Content="Случайные данные (100 элементов)"/>
                        <ComboBoxItem Content="Случайные данные (200 элементов)"/>
                        <ComboBoxItem Content="Случайные данные (500 элементов)"/>
                        <ComboBoxItem Content="Отсортированные данные"/>
                        <ComboBoxItem Content="Обратно отсортированные данные"/>
                        <ComboBoxItem Content="Почти отсортированные данные"/>
                        <ComboBoxItem Content="Много дубликатов"/>
                    </ComboBox>

                    <Button x:Name="LoadDataButton"
                            Content="Использовать набор"
                            Style="{StaticResource ModernButton}"
                            Margin="10,0,0,0"
                            Click="LoadDataButton_Click"/>

                    <Button x:Name="DeleteDataSetButton"
        Content="Удалить набор"
        Style="{StaticResource ModernButton}"
        Background="#3A7AFE"
        Margin="10,0,0,0"
        Click="DeleteDataSetButton_Click"/>

                    <Button x:Name="ManualInputButton"
                            Content="Ввести вручную"
                            Style="{StaticResource ModernButton}"
                            Background="#5A5A5A"
                            Margin="10,0,0,0"
                            Click="ManualInputButton_Click"/>

                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Статус:"
                               Foreground="#AAAAAA"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText"
                               Text="Готов"
                               Foreground="#3A7AFE"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Визуализация -->
            <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления -->
                    <Border Grid.Row="0" Background="#252525" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- ComboBox сортировок -->
                            <ComboBox x:Name="SortTypeComboBox"
                                      Style="{StaticResource ModernComboBox}"
                                      Width="210"
                                      Margin="0,0,10,0">
                                <ComboBoxItem Content="Bubble Sort (Пузырьковая)"/>
                                <ComboBoxItem Content="Quick Sort (Быстрая)"/>
                                <ComboBoxItem Content="Insertion Sort (Вставками)"/>
                                <ComboBoxItem Content="Selection Sort (Выбором)"/>
                                <ComboBoxItem Content="Merge Sort (Слиянием)"/>
                                <ComboBoxItem Content="Heap Sort (Пирамидальная)"/>
                            </ComboBox>

                            <Button x:Name="StartSortButton"
                                    Grid.Column="1"
                                    Content="Старт"
                                    Style="{StaticResource ModernButton}"
                                    Background="#3A7AFE"
                                    Click="StartSortButton_Click"/>

                            <Button x:Name="PauseButton"
                                    Grid.Column="2"
                                    Content="Пауза"
                                    Style="{StaticResource ModernButton}"
                                    Background="#5A5A5A"
                                    Margin="5,0,0,0"
                                    Click="PauseButton_Click"
                                    IsEnabled="False"/>

                            <Button x:Name="ResumeButton"
                                    Grid.Column="3"
                                    Content="Продолжить"
                                    Style="{StaticResource ModernButton}"
                                    Background="#3A7AFE"
                                    Margin="5,0,0,0"
                                    Click="ResumeButton_Click"
                                    IsEnabled="False"/>

                            <Button x:Name="StopButton"
                                    Grid.Column="4"
                                    Content="Стоп"
                                    Style="{StaticResource ModernButton}"
                                    Background="#D9534F"
                                    Margin="5,0,0,0"
                                    Click="StopButton_Click"
                                    IsEnabled="False"/>

                            <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="15,0,0,0">
                                <TextBlock Text="Задержка:"
                                           Foreground="#AAAAAA"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <Slider x:Name="DelaySlider"
                                        Width="100"
                                        Minimum="1"
                                        Maximum="200"
                                        Value="30"
                                        Style="{StaticResource ModernSlider}"/>
                                <TextBlock x:Name="DelayValueText"
                                           Text="30"
                                           Foreground="#3A7AFE"
                                           FontWeight="Bold"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Canvas -->
                    <Canvas x:Name="VisualizationCanvas"
                            Grid.Row="1"
                            Background="#111"
                            ClipToBounds="True"/>

                    <!-- Статистика -->
                    <Border Grid.Row="2" Background="#252525" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Сравнений:" Foreground="#AAAAAA" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ComparisonsText" Text="0" Foreground="#3A7AFE" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Обменов:" Foreground="#AAAAAA" Margin="0,0,10,0"/>
                                <TextBlock x:Name="SwapsText" Text="0" Foreground="#3A7AFE" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Элементов:" Foreground="#AAAAAA" Margin="0,0,10,0"/>
                                <TextBlock x:Name="ArraySizeText" Text="0" Foreground="#3A7AFE" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Правая панель -->
            <!-- Правая панель -->
            <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Padding="12" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0"
                   Text="История событий"
                   FontSize="15"
                   FontWeight="Bold"
                   Foreground="#3A7AFE"
                   Margin="0,0,0,10"/>

                    <!-- Лог событий -->
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" MaxHeight="250">
                        <ListBox x:Name="LogListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#CCCCCC">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252525" CornerRadius="4" Padding="7" Margin="0,2">
                                        <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!-- Кнопки: Очистить и Отчеты (всегда видны) -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ClearLogButton"
                    Content="Очистить"
                    Style="{StaticResource ModernButton}"
                    Background="#5A5A5A"
                    Width="90"
                    Click="ClearLogButton_Click"/>

                        <Button x:Name="ReportsButton"
                    Content="Отчеты"
                    Style="{StaticResource ModernButton}"
                    Background="#3A7AFE"
                    Width="90"
                    Margin="10,0,0,0"
                    Click="ReportsButton_Click"/>
                    </StackPanel>

                    <!-- Легенда цветов (всегда видна) -->
                    <Border Grid.Row="3" Background="#252525" CornerRadius="6" Padding="10" Margin="0,15,0,0">
                        <StackPanel>
                            <TextBlock Text="Легенда цветов" 
                           FontSize="13" 
                           FontWeight="Bold" 
                           Foreground="#3A7AFE"
                           Margin="0,0,0,8"/>

                            <!-- Общие цвета -->
                            <TextBlock Text="Обозначения:" 
                           FontSize="11" 
                           Foreground="#AAAAAA" 
                           Margin="0,0,0,5"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#46B84C" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Низкое значение (до 33%)" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#F1C40F" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Среднее значение (33-66%)" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#E74C3C" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Высокое значение (от 66%)" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Separator Background="#3A3A3A" Margin="0,8,0,8"/>

                            <!-- Цвета алгоритмов -->
                            <TextBlock Text="Алгоритмы:" 
                           FontSize="11" 
                           Foreground="#AAAAAA" 
                           Margin="0,0,0,5"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#3498DB" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Сравниваемый элемент" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#E67E22" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Меняемый / Вставляемый элемент" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#9B59B6" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Опорный элемент (Quick Sort)" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Width="18" Height="18" Fill="#2ECC71" RadiusX="3" RadiusY="3"/>
                                <TextBlock Grid.Column="1" Text="Минимальный элемент (Selection Sort)" Foreground="#CCCCCC" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </Grid>

                            <Separator Background="#3A3A3A" Margin="0,8,0,8"/>

                            <!-- Справка по алгоритмам -->
                            <TextBlock Text="Справка" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="#3A7AFE" 
                           Margin="0,0,0,5"/>

                            <TextBlock x:Name="AlgorithmInfo" 
                           Text="Выберите алгоритм для отображения информации" 
                           Foreground="#AAAAAA" 
                           FontSize="10" 
                           TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижний статус-бар -->
        <Border Grid.Row="2" Background="#252525" Padding="8">
            <TextBlock x:Name="InfoText"
                       Text="Выберите набор данных и запустите сортировку"
                       Foreground="#AAAAAA"
                       FontSize="11"/>
        </Border>
    </Grid>
</Window> 