<UserControl x:Class="SortVisualizer.Views.TournamentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="TournamentButton" TargetType="Button">
            <Setter Property="Background" Value="#3A7AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F63D8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555555"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор участников -->

        <Border Background="#252525" CornerRadius="6" Padding="8" Margin="0,0,0,10">
            <WrapPanel HorizontalAlignment="Center">
                <!-- Кнопка обновления -->
                <Button x:Name="UpdateButton" 
                Content="Обновить"  
                Style="{StaticResource TournamentButton}"
                Margin="0,0,10,0" 
                Click="UpdateButton_Click" 
                Width="91"/>

                <!-- Чекбоксы -->
                <CheckBox x:Name="ChkBubble" Content="Bubble" Foreground="White" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkQuick" Content="Quick" Foreground="White" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkInsertion" Content="Insertion" Foreground="White" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkSelection" Content="Selection" Foreground="White" IsChecked="True" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkMerge" Content="Merge" Foreground="White" IsChecked="True" VerticalAlignment="Center"/>

                <!-- Кнопки управления -->
                <Button x:Name="StartTournamentButton" 
                Content="Старт" 
                Style="{StaticResource TournamentButton}"
                Background="#2ECC71"
                Margin="10,0,0,0" 
                Click="StartTournamentButton_Click"/>

                <Button x:Name="PauseButton" 
                Content="Пауза" 
                Style="{StaticResource TournamentButton}"
                Background="#F39C12"
                Margin="5,0" 
                IsEnabled="False"
                Click="PauseButton_Click"/>

                <Button x:Name="ResumeButton" 
                Content="Продолжить" 
                Style="{StaticResource TournamentButton}"
                Background="#3498DB"
                Margin="5,0" 
                IsEnabled="False"
                Click="ResumeButton_Click"/>

                <Button x:Name="StopButton" 
                Content="Стоп" 
                Style="{StaticResource TournamentButton}"
                Background="#D9534F"
                Margin="5,0" 
                IsEnabled="False"
                Click="StopButton_Click"/>

                <!-- ПОЛЗУНОК ЗАДЕРЖКИ -->
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Задержка:" Foreground="#A0A0B0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="DelaySlider" 
                Width="80" 
                Minimum="0" 
                Maximum="100" 
                Value="5" 
                Foreground="#3A7AFE" 
                Background="#333" 
                VerticalAlignment="Center"/>
                    <TextBlock x:Name="DelayValueText" 
                   Text="5" 
                   Foreground="#3A7AFE" 
                   FontWeight="Bold" 
                   Margin="8,0,0,0" 
                   VerticalAlignment="Center"/>

                    <Button Content="ⓘ" 
                Width="22" 
                Height="22" 
                FontSize="12" 
                FontWeight="Bold"
                Background="Transparent" 
                Foreground="#3A7AFE" 
                BorderBrush="#3A7AFE" 
                BorderThickness="1"
                Cursor="Hand" 
                Margin="8,0,0,0"
                ToolTipService.ShowOnDisabled="True"
                ToolTipService.InitialShowDelay="0"
                ToolTipService.BetweenShowDelay="0">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="320">
                                    <TextBlock Text="Настройка скорости анимации в турнире" FontWeight="Bold" Foreground="#3A7AFE"/>
                                    <Separator Margin="0,5"/>
                                    <TextBlock Text="Задержка между шагами сортировки." Foreground="#252525" TextWrapping="Wrap"/>
                                    <TextBlock Text="По умолчанию: 5 мс (0.005 секунд)" Foreground="#252525"/>
                                    <TextBlock Text="Рекомендации:" FontWeight="Bold" Foreground="#252525"/>
                                    <TextBlock Text="• 0-10 мс → Быстрая анимация" Foreground="#252525"/>
                                    <TextBlock Text="• 10-30 мс → Средняя скорость" Foreground="#252525"/>
                                    <TextBlock Text="• 30-100 мс → Детальный просмотр" Foreground="#252525"/>
                                    <TextBlock Text="В турнире задержка применяется ко всем алгоритмам." Foreground="#252525"/>
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Область турнира -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="TournamentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Алгоритмы будут добавляться динамически -->
            </Grid>
        </ScrollViewer>

        <!-- Результаты -->
        <Border Grid.Row="2" Background="#252525" CornerRadius="6" Padding="8" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Победитель:" Foreground="#A0A0B0"/>
                <TextBlock x:Name="WinnerText" Text="—" Foreground="#2ECC71" FontWeight="Bold" Margin="10,0"/>
                <TextBlock Text="|" Foreground="#3A3A3A" Margin="20,0"/>
                <TextBlock Text="Общее время:" Foreground="#A0A0B0"/>
                <TextBlock x:Name="TotalTimeText" Text="0 мс" Foreground="#F39C12" Margin="10,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>