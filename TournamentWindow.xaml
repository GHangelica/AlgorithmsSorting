<Window x:Class="SortVisualizer.Views.TournamentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Турнир алгоритмов" 
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">

    <Window.Resources>
        <!-- Стиль для заголовков DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#40404F"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="BorderBrush" Value="#3A7AFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>

        <!-- Стиль для ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#252530"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A7AFE"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A7AFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопок -->
        <Style x:Key="TournamentButton" TargetType="Button">
            <Setter Property="Background" Value="#3A7AFE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2F63D8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#555"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Background="#252525" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ВИЗУАЛЬНЫЙ ТУРНИР АЛГОРИТМОВ" 
                           FontSize="18" FontWeight="Bold" Foreground="#3A7AFE"/>

                <Button x:Name="StartTournamentButton" 
                        Content="СТАРТ" 
                        Style="{StaticResource TournamentButton}"
                        Background="#2ECC71"
                        Margin="20,0,5,0"
                        Click="StartTournamentButton_Click"/>

                <Button x:Name="PauseTournamentButton" 
                        Content="ПАУЗА" 
                        Style="{StaticResource TournamentButton}"
                        Background="#F39C12"
                        Margin="5,0"
                        IsEnabled="False"
                        Click="PauseTournamentButton_Click"/>

                <Button x:Name="ResumeTournamentButton" 
                        Content="ПРОДОЛЖИТЬ" 
                        Style="{StaticResource TournamentButton}"
                        Background="#3498DB"
                        Margin="5,0"
                        IsEnabled="False"
                        Click="ResumeTournamentButton_Click"/>

                <Button x:Name="StopTournamentButton" 
                        Content="СТОП" 
                        Style="{StaticResource TournamentButton}"
                        Background="#D9534F"
                        Margin="5,0"
                        IsEnabled="False"
                        Click="StopTournamentButton_Click"/>

                <Button x:Name="CloseButton" 
                        Content="ЗАКРЫТЬ" 
                        Style="{StaticResource TournamentButton}"
                        Background="#5A5A5A"
                        Margin="20,0,0,0"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Информация о данных -->
        <Border Grid.Row="1" Background="#252525" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Данные:" Foreground="#A0A0B0"/>
                <TextBlock x:Name="ArrayInfo" Foreground="#3A7AFE" Margin="10,0"/>
                <Button x:Name="SelectDataButton" 
                        Content="Выбрать другие данные" 
                        Background="#5A5A5A" Foreground="White"
                        Padding="10,5" Cursor="Hand" 
                        Click="SelectDataButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Область турнира -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Bubble Sort -->
            <Border x:Name="BubbleBorder" Grid.Row="0" Grid.Column="0" Background="#252525" CornerRadius="8" Margin="5" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BUBBLE SORT" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#F39C12" Margin="5"/>
                    <ProgressBar x:Name="BubbleProgress" Height="3" Minimum="0" Maximum="100" Value="0" Margin="10,20,10,3"/>
                    <Canvas x:Name="BubbleCanvas" Grid.Row="1" Background="#1E1E1E" ClipToBounds="True"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="Время:" Foreground="#A0A0B0" FontSize="10"/>
                        <TextBlock x:Name="BubbleTime" Text="0 мс" Foreground="#F39C12" FontSize="10" Margin="5,0"/>
                        <TextBlock Text="| Сравнений:" Foreground="#A0A0B0" FontSize="10" Margin="5,0"/>
                        <TextBlock x:Name="BubbleComparisons" Text="0" Foreground="#F39C12" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Quick Sort -->
            <Border x:Name="QuickBorder" Grid.Row="0" Grid.Column="1" Background="#252525" CornerRadius="8" Margin="5" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="QUICK SORT" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#3498DB" Margin="5"/>
                    <ProgressBar x:Name="QuickProgress" Height="3" Minimum="0" Maximum="100" Value="0" Margin="10,21,10,2"/>
                    <Canvas x:Name="QuickCanvas" Grid.Row="1" Background="#1E1E1E" ClipToBounds="True"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="Время:" Foreground="#A0A0B0" FontSize="10"/>
                        <TextBlock x:Name="QuickTime" Text="0 мс" Foreground="#3498DB" FontSize="10" Margin="5,0"/>
                        <TextBlock Text="| Сравнений:" Foreground="#A0A0B0" FontSize="10" Margin="5,0"/>
                        <TextBlock x:Name="QuickComparisons" Text="0" Foreground="#3498DB" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Insertion Sort -->
            <Border x:Name="InsertionBorder" Grid.Row="0" Grid.Column="2" Background="#252525" CornerRadius="8" Margin="5" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="INSERTION SORT" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2ECC71" Margin="5"/>
                    <ProgressBar x:Name="InsertionProgress" Height="3" Minimum="0" Maximum="100" Value="0" Margin="14,22,5,1"/>
                    <Canvas x:Name="InsertionCanvas" Grid.Row="1" Background="#1E1E1E" ClipToBounds="True"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="Время:" Foreground="#A0A0B0" FontSize="10"/>
                        <TextBlock x:Name="InsertionTime" Text="0 мс" Foreground="#2ECC71" FontSize="10" Margin="5,0"/>
                        <TextBlock Text="| Сравнений:" Foreground="#A0A0B0" FontSize="10" Margin="5,0"/>
                        <TextBlock x:Name="InsertionComparisons" Text="0" Foreground="#2ECC71" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Selection Sort -->
            <Border x:Name="SelectionBorder" Grid.Row="1" Grid.Column="0" Background="#252525" CornerRadius="8" Margin="5" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELECTION SORT" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#9B59B6" Margin="5"/>
                    <ProgressBar x:Name="SelectionProgress" Height="3" Minimum="0" Maximum="100" Value="0" Margin="9,21,10,2"/>
                    <Canvas x:Name="SelectionCanvas" Grid.Row="1" Background="#1E1E1E" ClipToBounds="True"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="Время:" Foreground="#A0A0B0" FontSize="10"/>
                        <TextBlock x:Name="SelectionTime" Text="0 мс" Foreground="#9B59B6" FontSize="10" Margin="5,0"/>
                        <TextBlock Text="| Сравнений:" Foreground="#A0A0B0" FontSize="10" Margin="5,0"/>
                        <TextBlock x:Name="SelectionComparisons" Text="0" Foreground="#9B59B6" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Merge Sort -->
            <Border x:Name="MergeBorder" Grid.Row="1" Grid.Column="1" Background="#252525" CornerRadius="8" Margin="5" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="MERGE SORT" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E74C3C" Margin="5"/>
                    <ProgressBar x:Name="MergeProgress" Height="3" Minimum="0" Maximum="100" Value="0" Margin="15,21,4,2"/>
                    <Canvas x:Name="MergeCanvas" Grid.Row="1" Background="#1E1E1E" ClipToBounds="True"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="Время:" Foreground="#A0A0B0" FontSize="10"/>
                        <TextBlock x:Name="MergeTime" Text="0 мс" Foreground="#E74C3C" FontSize="10" Margin="5,0"/>
                        <TextBlock Text="| Сравнений:" Foreground="#A0A0B0" FontSize="10" Margin="5,0"/>
                        <TextBlock x:Name="MergeComparisons" Text="0" Foreground="#E74C3C" FontSize="10"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Таблица результатов -->
            <Border Grid.Row="1" Grid.Column="2" Background="#252525" CornerRadius="8" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="ТАБЛИЦА РЕЗУЛЬТАТОВ" FontSize="12" FontWeight="Bold" Foreground="#3A7AFE" TextAlignment="Center" Margin="0,0,0,10"/>

                    <DataGrid x:Name="ResultsGrid" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              Background="#2D2D3A" 
                              Foreground="White" 
                              BorderBrush="#40404F" 
                              RowHeight="28" 
                              FontSize="11"
                              AlternatingRowBackground="#3A3A4A"
                              RowBackground="#2D2D3A"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#40404F"
                              VerticalGridLinesBrush="Transparent">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A7AFE"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252525"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="White"/>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#2D2D3A"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                        <Setter Property="Background" Value="#2D2D3A"/>
                                    </Trigger>
                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="#3A3A4A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3A7AFE"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="BorderBrush" Value="#40404F"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Алгоритм" Binding="{Binding Name}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Сравнений" Binding="{Binding Comparisons}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Обменов" Binding="{Binding Swaps}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="5,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Итоги -->
        <Border Grid.Row="3" Background="#252525" CornerRadius="8" Padding="10" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="ПОБЕДИТЕЛЬ:" Foreground="#A0A0B0" FontSize="14" FontWeight="Bold"/>
                <TextBlock x:Name="WinnerText" Text="—" Foreground="#2ECC71" FontSize="14" FontWeight="Bold" Margin="10,0"/>
                <TextBlock Text="|" Foreground="#3A3A3A" Margin="20,0"/>
                <TextBlock Text="Общее время:" Foreground="#A0A0B0" FontSize="12"/>
                <TextBlock x:Name="TotalTimeText" Text="0 мс" Foreground="#F39C12" FontSize="12" Margin="10,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>